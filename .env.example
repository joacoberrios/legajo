# Postgres (en Vercel la carga sola la integración de Neon)
DATABASE_URL=postgres://usuario:clave@host/legajo?sslmode=require

# Texto largo y aleatorio para firmar las sesiones (openssl rand -base64 32)
AUTH_SECRET=

# Emails con acceso al panel /admin, separados por coma
ADMIN_EMAILS=

# Opcional (con costo): lectura con IA de tarjeta verde y chasis. Sin esto se usa el OCR gratis del celular.
ANTHROPIC_API_KEY=
# Opcional: modelo de visión (por defecto claude-sonnet-5-5)
OCR_MODEL=

# Solo para pruebas: si es "true", los talleres nuevos quedan verificados al registrarse
AUTO_VERIFY_WORKSHOPS=false

# Solo para desarrollo local: URL de la app (en producción en Vercel se usa sola el dominio de producción)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob (fotos y comprobantes). En Vercel las carga la integración del Blob store (OIDC).
# En local: `vercel env pull` trae BLOB_STORE_ID y VERCEL_OIDC_TOKEN.
BLOB_STORE_ID=
# private (por defecto) o public, según cómo creaste el store
BLOB_ACCESS=private

# Opcional: celular de soporte para el botón de ayuda en /recuperar
SUPPORT_WHATSAPP=

# Opcional: recuperar contraseña por email con Resend (EMAIL_FROM de un dominio verificado)
RESEND_API_KEY=
EMAIL_FROM="Legajo <no-responder@tudominio.com>"

# Mercado Pago (cobros). Access Token de "Tus integraciones" › Credenciales. Sin esto, los pagos quedan desactivados.
# Para probar: el Access Token de prueba (o el de un usuario de prueba) y MP_TEST_MODE=true.
MP_ACCESS_TOKEN=
MP_TEST_MODE=false
# Clave secreta de Webhooks (Tus integraciones › Webhooks). Si está, se valida la firma de cada aviso.
MP_WEBHOOK_SECRET=
